cabal-version: 3.0
name:          secret
version:       0.1.0.0
synopsis:
  A type-level barrier for values that must never be shown or serialised

description:
  A @Secret a@ newtype whose 'Show' renders a redacted placeholder and whose
  'ToJSON'\/'FromJSON', 'ToCBOR'\/'FromCBOR' and 'Codec.Serialise.Serialise'
  instances are compile-time errors carrying a custom message (via
  'GHC.TypeError'). The instances stay visible to the constraint solver, so a
  record containing a 'Secret' field can still @deriving stock (Show)@ for
  free while any attempt to serialise it fails to compile. The only accessor
  is the continuation-style 'withSecret'; there is no @revealSecret@.

author:        IOG
copyright:     2022 IOG
license:       Apache-2.0
license-files:
  LICENSE
  NOTICE

category:      Data, Security

source-repository head
  type:     git
  location: https://github.com/cardano-scaling/hydra

library
  default-language:   GHC2021
  default-extensions:
    DataKinds
    DerivingStrategies

  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wredundant-constraints -Wunused-packages

  hs-source-dirs:     src
  exposed-modules:    Data.Secret
  build-depends:
    , aeson
    , base
    , cardano-binary
    , serialise
