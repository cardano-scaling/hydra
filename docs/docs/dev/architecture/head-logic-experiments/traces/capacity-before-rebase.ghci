-- Reproduce #2924 with production rules at spike revision 386e95947.
-- Run from the repository root with cabal repl hydra-node:test:tests < this-file.
-- This is a diagnostic of the pre-fix behavior, not a regression expectation.
:set -w -XOverloadedRecordDot -XDuplicateRecordFields -XTypeApplications
import Cardano.Binary qualified as CBOR
import Control.Monad qualified as Monad
import Data.List qualified as List
import Data.Map.Strict qualified as Map
import Data.Set qualified as Set
import Data.Text.IO qualified as Text
import Hydra.HeadLogic qualified as Logic
import Hydra.HeadLogic.Interpreter qualified as Interpreter
import Hydra.HeadLogic.State qualified as State
import Hydra.Ledger.Simple qualified as Simple
import Hydra.Network.Message qualified as Network
import Hydra.Node.Environment qualified as Environment
import Hydra.Node.State qualified as Node
import Hydra.Tx.Accumulator qualified as Accumulator
import Hydra.Tx.Crypto qualified as Crypto
import Hydra.Tx.Snapshot qualified as Snapshot
import System.IO.Error qualified as IO
import Test.Hydra.HeadLogic.Mermaid qualified as Mermaid
import Test.Hydra.HeadLogic.Scenario qualified as Scenario
import Test.Hydra.Ledger.Simple qualified as Fixture
:{
let limit = fromIntegral Accumulator.maxAccumulatorSize
    initialUTxO = Fixture.utxoRefs [1 .. limit]
    initialAccumulator = Accumulator.buildFromUTxO @Simple.SimpleTx initialUTxO
    snapshot = Scenario.initialSnapshot
      { Snapshot.version = 1
      , Snapshot.number = 3
      , Snapshot.utxo = initialUTxO
      , Snapshot.accumulator = initialAccumulator
      , Snapshot.appliedAccumulator = initialAccumulator
      }
    environments = map Scenario.environment [0 .. 2]
    signatures = Crypto.aggregateInOrder
      (Map.fromList [(env.party, Crypto.sign env.signingKey snapshot) | env <- environments])
      Scenario.scenarioParties
    coordinated = (Scenario.openState Scenario.initialNode).coordinatedHeadState
    initialOpen = (Scenario.openState Scenario.initialNode)
      { State.coordinatedHeadState = coordinated
        { State.version = 1
        , State.localUTxO = initialUTxO
        , State.confirmedSnapshot = Snapshot.ConfirmedSnapshot snapshot signatures
        , State.seenSnapshot = State.LastSeenSnapshot 3
        }
      }
    initial = Scenario.initialNode{Node.headState = State.Open initialOpen}
    split = Simple.SimpleTx 1 (Fixture.utxoRef 1) (Fixture.utxoRefs [limit + 1, limit + 2])
    merge = Simple.SimpleTx 2 (Fixture.utxoRefs [2, 3]) (Fixture.utxoRef (limit + 3))
    input message = Logic.NetworkInput 2
      (Network.ReceivedMessage (List.head Scenario.scenarioParties) message)
    run n node message = Logic.update (Scenario.environment n) Simple.simpleLedger
      Node.initialChainTime node (input message)
    emitted outcome = case outcome of
      Logic.Continue{Logic.effects = effects} -> [message | Logic.NetworkEffect message <- effects]
      _ -> []
    traced node message = Interpreter.traceProgramWith
      (Interpreter.snapshotConfig (Scenario.environment 0) Simple.simpleLedger)
      (Logic.updateProgram (Logic.ruleEnvironment $ Scenario.environment 0)
        Node.initialChainTime node (input message))
    summarize node = let c = (Scenario.openState node).coordinatedHeadState
      in (Set.size c.localUTxO, c.seenSnapshot, (Snapshot.getSnapshot c.confirmedSnapshot).number)
    describeOutcome :: Logic.Outcome Simple.SimpleTx -> String
    describeOutcome = \case
      Logic.Error failure -> show failure
      Logic.Continue{} -> "Continue"
      Logic.Wait{} -> "Wait"
    afterSplitOutcomes = [run n initial (Network.ReqTx split) | n <- [0 .. 2]]
    afterSplit = map (Logic.aggregateState initial) afterSplitOutcomes
    requests = concatMap emitted afterSplitOutcomes
    request = List.head requests
    rejected = [run n node request | (n, node) <- zip [0 .. 2] afterSplit]
    afterRejected = zipWith Logic.aggregateState afterSplit rejected
    afterMergeOutcomes = [run n node (Network.ReqTx merge) | (n, node) <- zip [0 .. 2] afterRejected]
    afterMerge = zipWith Logic.aggregateState afterRejected afterMergeOutcomes
    roundTrip node = CBOR.decodeFull' (CBOR.serialize' node)
      :: Either CBOR.DecoderError (Node.NodeState Simple.SimpleTx)
    leaderSteps = [(initial, Network.ReqTx split), (List.head afterSplit, request), (List.head afterRejected, Network.ReqTx merge)]
    expectedError = Logic.Error (Logic.RequireFailed
      (Logic.ReqSnUTxOSetTooLarge (Accumulator.maxAccumulatorSize + 1) Accumulator.maxAccumulatorSize))
    signatureCheck = Crypto.verifyMultiSignature
      (map (Crypto.getVerificationKey . Environment.signingKey) environments) signatures snapshot
    check :: String -> Bool -> IO ()
    check label condition = Monad.unless condition (IO.ioError $ IO.userError label)
:}
check "invalid starting signatures" (signatureCheck == Crypto.Verified)
check "unexpected request" (requests == [Network.ReqSn 1 4 [1] Nothing Nothing])
check "not all parties reject for capacity" (rejected == replicate 3 expectedError)
check "merge did not reduce local size" (all ((== Accumulator.maxAccumulatorSize) . Set.size . (.localUTxO) . (.coordinatedHeadState) . Scenario.openState) afterMerge)
check "a replacement request was emitted" (null $ concatMap emitted afterMergeOutcomes)
check "checkpoint changed state" (all (\node -> roundTrip node == Right node) afterMerge)
check "trace differs from execution" (all (\(node, message) -> fst (traced node message) == run 0 node message) leaderSteps)
print signatureCheck
print ("after split", map summarize afterSplit)
print ("snapshot outcomes", map describeOutcome rejected)
print ("after merge", map summarize afterMerge)
print ("new requests", length $ concatMap emitted afterMergeOutcomes)
print ("checkpoint round trips preserve all three states", True)
Text.writeFile "/tmp/head-logic-capacity.mmd" (Mermaid.renderTraces [("Leader receives the split", snd $ traced initial (Network.ReqTx split)), ("Leader receives its oversized request (ReqSnUTxOSetTooLarge)", snd $ traced (List.head afterSplit) request), ("Leader receives an independent merge", snd $ traced (List.head afterRejected) (Network.ReqTx merge))])
:quit
