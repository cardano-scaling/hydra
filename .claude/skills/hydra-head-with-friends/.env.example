# Copy to `.env` and edit. `docker compose` and `setup.sh` both read this file.

# Your short name. Must match your key filenames in credentials/ (e.g.
# alice-node.sk) and the `node-id` in config/hydra-node.yaml.
MY_NAME=alice

# Public TCP port your friends reach you on. Must match the port in your
# `advertise` (config/hydra-node.yaml) and be forwarded to this host.
PEER_PORT=5001

# Local-only client API port (host loopback).
API_PORT=4001

# --- Pinned versions --------------------------------------------------------
# Everyone in the head should run the same HYDRA_VERSION.
HYDRA_VERSION=2.3.0

# cardano-node used with Hydra 2.3.0 on preprod (per the Hydra testnet tutorial).
# If preprod later hard-forks to a newer era and this refuses to sync, bump to a
# current release: https://github.com/IntersectMBO/cardano-node/releases
CARDANO_NODE_VERSION=11.0.1

# Mithril client image used by setup.sh to fast-bootstrap the Cardano DB.
MITHRIL_IMAGE=ghcr.io/input-output-hk/mithril-client:latest
