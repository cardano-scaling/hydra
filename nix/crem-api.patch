+{-# LANGUAGE DataKinds #-}
+{-# LANGUAGE GADTs #-}
+
+module AllowedTransition (allowed) where
+
+import Crem.BaseMachine (ActionResult (ChooseTransition), Transition (Transition))
+import Crem.Topology (Topology (Topology))
+import Data.Functor.Identity (Identity)
+
+data Phase = Checking | Accepted | Waiting
+
+type RequestTopology = 'Topology '[ '( 'Checking, '[ 'Accepted, 'Waiting])]
+
+data State phase where
+  Check :: State 'Checking
+  Accept :: State 'Accepted
+  Wait :: State 'Waiting
+
+allowed :: Identity Bool -> ActionResult Identity RequestTopology State 'Checking ()
+allowed query = ChooseTransition $ do
+  valid <- query
+  pure $ if valid then Transition () Accept else Transition () Wait
