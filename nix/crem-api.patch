@@ -0,0 +1,18 @@
+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "$0")/.."
+
+# Compile the allowed counterpart first so a missing package cannot pass the
+# negative test. Keep compiler output outside the source tree.
+cabal build lib:crem -ferrors
+cabal exec -- ghc -fno-code -XGHC2021 -package crem typecheck/AllowedTransition.hs
+crem_typecheck_log=$(mktemp)
+trap 'rm -f "$crem_typecheck_log"' EXIT
+if cabal exec -- ghc -fno-code -XGHC2021 -package crem typecheck/ForbiddenTransition.hs >"$crem_typecheck_log" 2>&1; then
+  echo "ERROR: forbidden transition compiled" >&2
+  exit 1
+fi
+cat "$crem_typecheck_log"
+rg -q 'No instance for.*AllowedTransition' "$crem_typecheck_log"
+rg -q "'?Accepted '?Checking" "$crem_typecheck_log"
+echo "Allowed transition compiled; forbidden transition rejected by its edge constraint."
