--- /dev/null
+++ b/examples/Crem/Example/Transaction/Program.hs
@@ -0,0 +1,45 @@
+-- | A small free program for the transaction example. The interpreter controls
+-- ledger replies and records queries and decisions; it does not select states.
+module Crem.Example.Transaction.Program
+  ( Program
+  , Trace (..)
+  , applyTransaction
+  , decide
+  , runProgram
+  ) where
+
+import "free" Control.Monad.Free (Free (..), liftF)
+
+data Instruction next
+  = ApplyTransaction Int (Either String Int -> next)
+  | Decide String Bool next
+  deriving stock (Functor)
+
+type role Instruction representational
+
+type Program = Free Instruction
+
+data Trace
+  = LedgerQuery Int (Either String Int)
+  | Decision String Bool
+  deriving stock (Eq, Show)
+
+applyTransaction :: Int -> Program (Either String Int)
+applyTransaction transaction = liftF $ ApplyTransaction transaction id
+
+decide :: String -> Bool -> Program ()
+decide name result = liftF $ Decide name result ()
+
+runProgram :: (Int -> Either String Int) -> Program a -> ([Trace], a)
+runProgram reply = go
+  where
+    go :: Program b -> ([Trace], b)
+    go (Pure result) = ([], result)
+    go (Free instruction) = case instruction of
+      ApplyTransaction transaction next ->
+        let result = reply transaction
+         in prepend (LedgerQuery transaction result) (go $ next result)
+      Decide name result next -> prepend (Decision name result) (go next)
+
+    prepend :: Trace -> ([Trace], b) -> ([Trace], b)
+    prepend entry (entries, result) = (entry : entries, result)
