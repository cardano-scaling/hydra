+module Main (main) where
+
+import "crem" Crem.Example.Transaction (machine)
+import "crem" Crem.Example.Transaction.Program (runProgram)
+import "crem" Crem.Inspect (checkStates, inspectStates)
+import "crem" Crem.Render.Render (baseMachineAsGraph, getText, renderStateDiagram)
+import "crem" Crem.StateMachine (StateMachineT (Basic), run)
+import "text" Data.Text.IO qualified as Text
+
+main :: IO ()
+main = do
+  Text.putStrLn $ getText $ renderStateDiagram $ baseMachineAsGraph machine
+  mapM_ demonstrate [Right 42, Left "missing input"]
+  where
+    demonstrate :: Either String Int -> IO ()
+    demonstrate reply = do
+      let (trace, (output, next)) = runProgram (const reply) $ run (Basic machine) 7
+      mapM_ print trace
+      print output
+      checks <- checkStates [] next
+      print checks
+      print $ inspectStates next
