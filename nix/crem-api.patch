+-- | Optional observations of a machine's retained state. Descriptions and
+-- checks are separate: checking must not force a description or its payload.
+module Crem.StateInspection
+  ( StateInspector (..)
+  , StateCheck (..)
+  , describeOnly
+  , checkNoThunks
+  ) where
+
+import "base" Data.Kind (Type)
+import "nothunks" NoThunks.Class (Context, NoThunks (noThunks), ThunkInfo)
+import "text" Data.Text (Text)
+
+-- | The machine author supplies observations for every phase. A phase without
+-- a complete state checker returns 'NotInspected'. Checks cover state data,
+-- not action closures or effect environments.
+data StateInspector (state :: vertex -> Type) = StateInspector
+  { describeState :: forall phase. state phase -> Text
+  , checkState :: forall phase. Context -> state phase -> IO StateCheck
+  }
+
+type role StateInspector representational
+
+-- | An absent checker is unknown, never a successful strictness check.
+data StateCheck
+  = NotInspected
+  | CheckPassed
+  | FoundThunk ThunkInfo
+  deriving stock (Show)
+
+-- | Describe phases without claiming to check their retained data.
+describeOnly :: (forall phase. state phase -> Text) -> StateInspector state
+describeOnly description = StateInspector description (\_ _ -> pure NotInspected)
+
+-- | Adapt an existing 'NoThunks' instance to a state inspection callback.
+checkNoThunks :: (NoThunks a) => Context -> a -> IO StateCheck
+checkNoThunks context value = maybe CheckPassed FoundThunk <$> noThunks context value
