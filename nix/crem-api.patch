+-- Singleton-generated declarations use unticked promoted constructors.
+{-# OPTIONS_GHC -Wno-unticked-promoted-constructors #-}
+
+-- | A transaction-shaped example, not a ledger or a Hydra protocol rule.
+-- One program queries a primitive and chooses either of two allowed phases.
+module Crem.Example.Transaction
+  ( Phase (..)
+  , TransactionTopology
+  , transactionTopology
+  , sTransactionTopology
+  , machine
+  ) where
+
+import Crem.Example.Transaction.Program (Program, applyTransaction, decide)
+import "crem" Crem.BaseMachine (ActionResult (..), BaseMachineT (..), InitialState (..), Transition (..), pureResult)
+import "crem" Crem.Render.RenderableVertices (AllVertices (..), RenderableVertices)
+import "crem" Crem.StateInspection (StateInspector (..), checkNoThunks)
+import "crem" Crem.Topology (STopology (STopology), Topology (Topology), TopologySym0)
+import "nothunks" NoThunks.Class (NoThunks (..))
+import "singletons-base" Data.Singletons.Base.TH (NilSym0, SList (SCons, SNil), STuple2 (STuple2), Tuple2Sym0, singletons, type (:@#@$))
+import "text" Data.Text qualified as Text
+
+$( singletons
+    [d|
+      data Phase = Checking | Accepted | Waiting
+
+      transactionTopology :: Topology Phase
+      transactionTopology = Topology [(Checking, [Accepted, Waiting])]
+      |]
+ )
+
+deriving stock instance Eq Phase
+deriving stock instance Show Phase
+deriving stock instance Enum Phase
+deriving stock instance Bounded Phase
+deriving via AllVertices Phase instance RenderableVertices Phase
+
+data State phase where
+  Check :: State 'Checking
+  Applied :: !Int -> State 'Accepted
+  Awaiting :: !String -> State 'Waiting
+
+type role State nominal
+
+instance NoThunks (State phase) where
+  showTypeOf _ = "Transaction.State"
+  wNoThunks context = \case
+    Check -> pure Nothing
+    Applied after -> noThunks context after
+    Awaiting reason -> noThunks context reason
+
+machine :: BaseMachineT Program TransactionTopology Int String
+machine = BaseMachineT (InspectableState inspector Check) step
+  where
+    step :: State from -> Int -> ActionResult Program TransactionTopology State from String
+    step Check transaction = ChooseTransition $ do
+      reply <- applyTransaction transaction
+      case reply of
+        Right after -> do
+          decide "ledger accepts transaction" True
+          pure $ Transition "accepted" (Applied after)
+        Left reason -> do
+          decide "ledger accepts transaction" False
+          pure $ Transition "wait" (Awaiting reason)
+    step state@Applied {} _ = pureResult "already accepted" state
+    step state@Awaiting {} _ = pureResult "already waiting" state
+
+    inspector :: StateInspector State
+    inspector =
+      StateInspector
+        { describeState = \case
+            Check -> "Checking"
+            Applied after -> "Accepted: " <> Text.pack (show after)
+            Awaiting reason -> "Waiting: " <> Text.pack reason
+        , checkState = checkNoThunks
+        }
