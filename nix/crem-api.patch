+{-# LANGUAGE GADTs #-}
+
+-- | Inspect retained state without executing a machine's actions.
+module Crem.Inspect
+  ( Component (..)
+  , inspectStates
+  , checkStates
+  ) where
+
+import Crem.BaseMachine (BaseMachineT (..), InitialState (..))
+import Crem.StateInspection (StateCheck (..), StateInspector (..))
+import Crem.StateMachine (StateMachineT (..))
+import Crem.Topology (Topology)
+import "nothunks" NoThunks.Class (Context)
+import "text" Data.Text (Text)
+
+-- | A path follows the binary composition tree, from the root to a leaf.
+data Component = LeftComponent | RightComponent
+  deriving stock (Eq, Show)
+
+-- | Descriptions are supplied by the author; they may redact private data.
+-- 'Nothing' marks a leaf without an inspector.
+inspectStates :: StateMachineT m a b -> [([Component], Maybe Text)]
+inspectStates = leaves $ \(BaseMachineT storedState _) -> case storedState of
+  InitialState _ -> Nothing
+  InspectableState inspector state -> Just $ describeState inspector state
+
+-- | Check every leaf, including inactive alternatives. This reports unknown
+-- leaves explicitly and makes no claim about action closures or effects.
+checkStates :: Context -> StateMachineT m a b -> IO [([Component], StateCheck)]
+checkStates context = traverse (\(path, check) -> (path,) <$> check) . leaves checkBase
+  where
+    checkBase :: BaseMachineT m topology input output -> IO StateCheck
+    checkBase (BaseMachineT storedState _) = case storedState of
+      InitialState _ -> pure NotInspected
+      InspectableState inspector state ->
+        checkState inspector context state
+
+leaves
+  :: forall m result input output
+   . (forall vertex (topology :: Topology vertex) a b. BaseMachineT m topology a b -> result)
+  -> StateMachineT m input output
+  -> [([Component], result)]
+leaves visit = go []
+  where
+    go :: [Component] -> StateMachineT m a b -> [([Component], result)]
+    go path = \case
+      Basic machine -> [(reverse path, visit machine)]
+      Executable machine -> [(reverse path, visit machine)]
+      Sequential left right -> branch path left right
+      Parallel left right -> branch path left right
+      Alternative left right -> branch path left right
+      Feedback left right -> branch path left right
+      Kleisli left right -> branch path left right
+
+    branch :: [Component] -> StateMachineT m a b -> StateMachineT m c d -> [([Component], result)]
+    branch path left right = go (LeftComponent : path) left <> go (RightComponent : path) right
