+
+module Crem.ApiSketchSpec (spec) where
+
+import "base" Control.Exception (evaluate)
+import "base" Data.Either (isLeft, isRight)
+import "base" Data.Functor.Identity (Identity (..))
+import "base" Data.IORef (newIORef, readIORef)
+import "crem" Crem.BaseMachine (ActionResult (..), BaseMachineT (..), InitialState (..), Transition (..), baseHoist, pureResult, runBaseMachineT, withStateInspector)
+import "crem" Crem.BaseMachine qualified as Base
+import "crem" Crem.Decider (Decider (..), EvolutionResult (..), deciderMachine, rebuildDecider)
+import "crem" Crem.Example.Transaction qualified as Transaction
+import "crem" Crem.Example.Transaction.Program (Program, Trace (..), runProgram)
+import "crem" Crem.Inspect (Component (..), checkStates, inspectStates)
+import "crem" Crem.Render.Render (machineAsGraph, renderUntypedGraph)
+import "crem" Crem.Render.RenderFlow (TreeMetadata (..), renderFlow)
+import "crem" Crem.StateInspection (StateCheck (..), StateInspector (..), checkNoThunks, describeOnly)
+import "crem" Crem.StateMachine (StateMachineT (..), hoist, run, stateless, withoutRendering)
+import "crem" Crem.Topology (Topology (..))
+import "hspec" Test.Hspec (Expectation, Spec, describe, it, shouldBe, shouldSatisfy)
+import "nothunks" NoThunks.Class (NoThunks (..))
+import "profunctors" Data.Profunctor (Choice (..), Profunctor (..), Strong (..))
+import "text" Data.Text qualified as Text
+
+spec :: Spec
+spec = do
+  describe "effect-selected destinations" $ do
+    it "queries once, chooses Accepted, and traces the decision in the Program" $ do
+      let (trace, (output, next)) = runProgram (const $ Right 42) $ run (Basic Transaction.machine) 7
+      trace `shouldBe` [LedgerQuery 7 (Right 42), Decision "ledger accepts transaction" True]
+      output `shouldBe` "accepted"
+      inspectStates next `shouldBe` [([], Just "Accepted: 42")]
+      let (again, (outputAgain, _)) = runProgram (const $ Left "unused") $ run next 8
+      again `shouldBe` []
+      outputAgain `shouldBe` "already accepted"
+
+    it "chooses Waiting with the same instruction interpreter" $ do
+      let (trace, (output, next)) = runProgram (const $ Left "missing input") $ run (Basic Transaction.machine) 7
+      trace `shouldBe` [LedgerQuery 7 (Left "missing input"), Decision "ledger accepts transaction" False]
+      output `shouldBe` "wait"
+      inspectStates next `shouldBe` [([], Just "Waiting: missing input")]
+
+    it "preserves reply-dependent choice when hoisted" $ do
+      let interpret :: Program a -> Identity a
+          interpret = Identity . snd . runProgram (const $ Right 42)
+          (output, next) = runIdentity $ run (hoist interpret $ Executable Transaction.machine) 7
+      output `shouldBe` "accepted"
+      inspectStates next `shouldBe` [([], Just "Accepted: 42")]
+
+    it "sequences outputs while keeping the chosen destination" $ do
+      let result :: ActionResult Identity SampleTopology Sample 'Before [Int]
+          result = ChooseTransition $ pure $ Transition [3, 5] (Moved 9)
+          outputs = Base.runActionResult $ Base.sequence $ fmap (fmap (+ 1)) result
+      [output | Transition output _ <- outputs] `shouldBe` [4, 6]
+
+  describe "execution without rendering dictionaries" $ do
+    it "keeps effects, outputs and retained inspection when dropping composition metadata" $ do
+      let leaf = Basic $ rmap length Transaction.machine
+      preservesExecution (Sequential leaf leaf) 2
+      preservesExecution (Parallel leaf leaf) (2, 3)
+      preservesExecution (Alternative leaf leaf) (Left 2)
+      preservesExecution (Alternative leaf leaf) (Right 3)
+      preservesExecution (Kleisli (rmap (: []) leaf) (rmap (: []) leaf)) 2
+      preservesExecution (Feedback (rmap (: []) leaf) (rmap (const []) leaf)) 2
+
+    it "drops metadata without running actions or losing initial descriptions" $ do
+      let original = Basic Transaction.machine
+          executable = withoutRendering original
+      (renderUntypedGraph <$> machineAsGraph original) `shouldSatisfy` isRight
+      (renderUntypedGraph <$> machineAsGraph executable) `shouldSatisfy` isLeft
+      inspectStates executable `shouldBe` inspectStates original
+      inspectStates (withoutRendering executable) `shouldBe` inspectStates original
+
+    it "runs a phase type with no Eq, Show, singleton or RenderableVertices instances" $ do
+      let (output, next) = runIdentity $ run (Executable $ sample 10) 2
+      output `shouldBe` 12
+      inspectStates next `shouldBe` [([], Just "After: 12")]
+
+    it "reports missing topology instead of rendering a partial composition" $ do
+      let machine = Sequential (stateless (+ 1)) (Executable $ sample 10)
+      (renderUntypedGraph <$> machineAsGraph machine)
+        `shouldBe` Left "Executable has no rendering metadata; use Basic to retain it"
+      renderFlow (BinaryLabel (LeafLabel "input") (LeafLabel "sample")) machine
+        `shouldSatisfy` isLeft
+
+  describe "retained state inspection" $ do
+    it "attaches and replaces an inspector without changing restored state" $ do
+      let named = withStateInspector sampleInspector (InitialState $ Stored 10)
+          described = withStateInspector (describeOnly $ const "redacted") named
+          (output, next) = runIdentity $ runBaseMachineT (sampleFrom described) 2
+      output `shouldBe` 12
+      inspectStates (Executable next) `shouldBe` [([], Just "redacted")]
+      checks <- checkStates [] (Executable next)
+      map (checkName . snd) checks `shouldBe` ["unknown"]
+
+    it "preserves descriptions without claiming a state check" $ do
+      let inspector = describeOnly $ \case
+            Stored _ -> "Before"
+            Moved _ -> "After"
+          machine = Executable $ sampleFrom $ InspectableState inspector (Stored 10)
+          (_, next) = runIdentity $ run machine 2
+      inspectStates next `shouldBe` [([], Just "After")]
+      checks <- checkStates [] next
+      map (checkName . snd) checks `shouldBe` ["unknown"]
+
+    it "does not evaluate a description when its checker is absent" $ do
+      let machine =
+            Executable $
+              sampleFrom $
+                InspectableState (describeOnly $ \_ -> error "description must not run during check") (Stored 10)
+      checks <- checkStates [] machine
+      map (checkName . snd) checks `shouldBe` ["unknown"]
+
+    it "reports an uninspected leaf as unknown" $ do
+      checks <- checkStates [] (stateless id :: StateMachineT Identity Int Int)
+      map (checkName . snd) checks `shouldBe` ["unknown"]
+
+    it "finds a real payload thunk, without evaluating the state description" $ do
+      ref <- newIORef (20 :: Int)
+      value <- readIORef ref
+      stored <- evaluate $ Stored (suspended value)
+      let machine =
+            Executable $
+              sampleFrom $
+                InspectableState
+                  sampleInspector
+                    { describeState = \_ -> error "description must not run during check"
+                    }
+                  stored
+      checks <- checkStates [] machine
+      map (checkName . snd) checks `shouldBe` ["thunk"]
+
+    it "checks the updated state and retains inspectors through base mappings" $ do
+      let mapped :: BaseMachineT Identity SampleTopology (Int, Bool) (Int, Bool)
+          mapped = first' $ rmap (+ 1) $ lmap (+ 2) $ sample 10
+          (output, next) = runIdentity $ runBaseMachineT mapped (3, True)
+      output `shouldBe` (16, True)
+      inspectStates (Executable next) `shouldBe` [([], Just "After: 15")]
+      checks <- checkStates [] (Executable next)
+      map (checkName . snd) checks `shouldBe` ["passed"]
+
+    it "detects a thunk introduced by a transition before describing its state" $ do
+      ref <- newIORef (20 :: Int)
+      value <- readIORef ref
+      let machine :: BaseMachineT Identity SampleTopology Int ()
+          machine = BaseMachineT (InspectableState sampleInspector $ Stored 0) $ \state input -> case state of
+            Stored _ -> ChooseTransition $ pure $ Transition () (Moved $ suspended input)
+            Moved _ -> pureResult () state
+          (_, next) = runIdentity $ runBaseMachineT machine value
+      checks <- checkStates [] (Executable next)
+      map (checkName . snd) checks `shouldBe` ["thunk"]
+
+    it "preserves inspection when Maybe and Either inputs skip the action" $ do
+      let (_, maybeNext) = runIdentity $ runBaseMachineT (Base.maybeM $ sample 10) Nothing
+          (_, eitherNext) = runIdentity $ runBaseMachineT (Base.eitherM $ sample 10) (Left ())
+          (_, choiceNext) = runIdentity $ runBaseMachineT (left' $ sample 10) (Right ())
+      inspectStates (Executable maybeNext) `shouldBe` [([], Just "Before: 10")]
+      inspectStates (Executable eitherNext) `shouldBe` [([], Just "Before: 10")]
+      inspectStates (Executable choiceNext) `shouldBe` [([], Just "Before: 10")]
+
+    it "keeps both state inspectors through sequential, parallel, and alternative execution" $ do
+      let leaf = Executable $ sample 10
+          (_, sequential) = runIdentity $ run (Sequential leaf leaf) 2
+          (_, parallel) = runIdentity $ run (Parallel leaf leaf) (2, 3)
+          (_, alternative) = runIdentity $ run (Alternative leaf leaf) (Left 2)
+      inspectStates sequential `shouldBe` two "After: 12" "After: 22"
+      inspectStates parallel `shouldBe` two "After: 12" "After: 13"
+      inspectStates alternative `shouldBe` two "After: 12" "Before: 10"
+      checks <- checkStates [] alternative
+      map (checkName . snd) checks `shouldBe` ["passed", "passed"]
+
+    it "keeps inspectors through Kleisli and finite feedback execution" $ do
+      let forward = Executable $ rmap (: []) $ sample 10
+          stop :: StateMachineT Identity Int [Int]
+          stop = Executable $ rmap (const []) $ sample 10
+          (_, kleisli) = runIdentity $ run (Kleisli forward forward) 2
+          (_, feedback) = runIdentity $ run (Feedback forward stop) 2
+      inspectStates kleisli `shouldBe` two "After: 12" "After: 22"
+      inspectStates feedback `shouldBe` two "After: 12" "After: 22"
+
+    it "preserves the inspector when rebuilding a decider" $ do
+      let decider :: Decider SampleTopology () Int
+          decider =
+            Decider
+              (InspectableState sampleInspector $ Stored 10)
+              (\() _ -> 17)
+              ( \state value -> case state of
+                  Stored _ -> EvolutionResult $ Moved value
+                  Moved _ -> EvolutionResult $ Moved value
+              )
+          rebuilt = rebuildDecider [12, 17] decider
+      inspectStates (Executable $ deciderMachine rebuilt @Identity)
+        `shouldBe` [([], Just "After: 17")]
+
+    it "preserves the inspector when hoisting a base machine" $ do
+      let next = baseHoist (Just . runIdentity) $ sample 10
+      inspectStates (Executable next) `shouldBe` [([], Just "Before: 10")]
+  where
+    two :: Text.Text -> Text.Text -> [([Component], Maybe Text.Text)]
+    two left right = [([LeftComponent], Just left), ([RightComponent], Just right)]
+
+-- Compare two consecutive runs, including the retained phase selected by each
+-- primitive reply. Metadata removal must not add, omit or repeat an effect.
+preservesExecution :: (Eq b, Show b) => StateMachineT Program a b -> a -> Expectation
+preservesExecution original input = do
+  let execute machine = runProgram (const $ Right 42) $ run machine input
+      (expectedTrace, (expected, retained)) = execute original
+      (actualTrace, (actual, stripped)) = execute $ withoutRendering original
+      (nextExpectedTrace, (nextExpected, nextRetained)) = execute retained
+      (nextActualTrace, (nextActual, nextStripped)) = execute stripped
+  (actualTrace, actual) `shouldBe` (expectedTrace, expected)
+  (nextActualTrace, nextActual) `shouldBe` (nextExpectedTrace, nextExpected)
+  inspectStates stripped `shouldBe` inspectStates retained
+  inspectStates nextStripped `shouldBe` inspectStates nextRetained
+
+-- No singleton generation or rendering instances for this phase type.
+data Phase = Before | After
+
+type SampleTopology = 'Topology '[ '( 'Before, '[ 'After])]
+
+data Sample phase where
+  Stored :: Int -> Sample 'Before
+  Moved :: Int -> Sample 'After
+
+type role Sample nominal
+
+instance NoThunks (Sample phase) where
+  showTypeOf _ = "Sample"
+  wNoThunks context = \case
+    Stored value -> noThunks context value
+    Moved value -> noThunks context value
+
+sampleInspector :: StateInspector Sample
+sampleInspector =
+  StateInspector
+    { describeState = \case
+        Stored value -> "Before: " <> Text.pack (show value)
+        Moved value -> "After: " <> Text.pack (show value)
+    , checkState = checkNoThunks
+    }
+
+sample :: Int -> BaseMachineT Identity SampleTopology Int Int
+sample = sampleFrom . InspectableState sampleInspector . Stored
+
+sampleFrom :: InitialState Sample -> BaseMachineT Identity SampleTopology Int Int
+sampleFrom initial = BaseMachineT initial $ \state input -> case state of
+  Stored value ->
+    ChooseTransition $
+      Identity $
+        let after = value + input
+         in after `seq` Transition after (Moved after)
+  Moved value -> pureResult value state
+
+checkName :: StateCheck -> String
+checkName NotInspected = "unknown"
+checkName CheckPassed = "passed"
+checkName FoundThunk {} = "thunk"
+
+suspended :: Int -> Int
+suspended value = value + 1
+{-# NOINLINE suspended #-}
