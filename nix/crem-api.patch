+{-# LANGUAGE DataKinds #-}
+{-# LANGUAGE GADTs #-}
+
+module ForbiddenTransition (forbidden) where
+
+import Crem.BaseMachine (ActionResult (ChooseTransition), Transition (Transition))
+import Crem.Topology (Topology (Topology))
+import Data.Functor.Identity (Identity)
+
+data Phase = Checking | Accepted | Waiting
+
+type RequestTopology = 'Topology '[ '( 'Checking, '[ 'Accepted, 'Waiting])]
+
+data State phase where
+  Check :: State 'Checking
+  Accept :: State 'Accepted
+  Wait :: State 'Waiting
+
+-- Even a reply-selected transition cannot go from Accepted back to Checking.
+forbidden :: Identity Bool -> ActionResult Identity RequestTopology State 'Accepted ()
+forbidden query = ChooseTransition $ do
+  retry <- query
+  pure $ if retry then Transition () Check else Transition () Accept
