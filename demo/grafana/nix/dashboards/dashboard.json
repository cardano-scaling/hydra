    {
      "id": 7,
      "title": "Transaction confirmation latency",
      "description": "First local ReqTx processing to confirmation. Missing timings after restart or eviction are excluded. Empty windows have no value.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(hydra_head_tx_confirmation_seconds_sum{job=\"hydra_nodes\",instance=~\"${instance:regex}\"}[$__rate_interval]) / rate(hydra_head_tx_confirmation_seconds_count{job=\"hydra_nodes\",instance=~\"${instance:regex}\"}[$__rate_interval])",
          "legendFormat": "{{instance}} mean",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": false,
          "range": true,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (instance, le) (rate(hydra_head_tx_confirmation_seconds_bucket{job=\"hydra_nodes\",instance=~\"${instance:regex}\"}[$__rate_interval])))",
          "legendFormat": "{{instance}} p95",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": false,
          "range": true,
          "editorMode": "code"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
