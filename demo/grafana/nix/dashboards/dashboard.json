  "description": "Per-node Hydra health and process-lifetime work. Replicas confirm the same transactions; do not sum their rates as unique Head throughput.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": 2,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Scrapeable nodes",
      "description": "Instant count of successful scrapes among selected targets. Zero also occurs if target discovery is empty; inspect the targets panel.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=\"hydra_nodes\",instance=~\"${instance:regex}\"} == 1) or vector(0)",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false,
          "fields": ""
        },
        "graphMode": "none",
        "colorMode": "none"
      }
    },
